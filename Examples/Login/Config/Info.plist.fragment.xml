<!-- Fragmento para el Info.plist de la app. Xcode sustituye $(…) con el xcconfig de la configuración activa.
     Environment(bundle: .main) lee este diccionario. -->
<key>JadeAPI</key>
<dict>
    <key>stage</key>
    <string>$(JADE_STAGE)</string>
    <key>services</key>
    <dict>
        <key>auth</key>
        <dict>
            <key>baseURL</key>
            <string>$(JADE_AUTH_BASE_URL)</string>
        </dict>
        <key>catalog</key>
        <dict>
            <key>baseURL</key>
            <string>$(JADE_CATALOG_BASE_URL)</string>
            <key>timeout</key>
            <string>10</string>
            <key>retries</key>
            <string>2</string>
        </dict>
    </dict>
</dict>
