// Desarrollo: overrides por argumento/variable activos (Environment.applyingLaunchOverrides solo existe
// en Debug) y un archivo local opcional para apuntar un servicio al sandbox de cada quien.
#include "Base.xcconfig"
JADE_STAGE = live
JADE_AUTH_BASE_URL    = $(HTTPS)dummyjson.com
JADE_CATALOG_BASE_URL = $(HTTPS)dummyjson.com
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
#include? "Local.xcconfig"
